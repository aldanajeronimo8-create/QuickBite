    "backup:verify": "node scripts/verify-backup.mjs",
    "backup:restore": "node scripts/restore-backup.mjs",
    "verify:excel-only": "node scripts/verify-excel-only.mjs",
    "prepare": "husky",
    "test:k6": "k6 run tests/k6/quickbite-load.js",
