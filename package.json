    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --require ./scripts/esbuild-windows-spawn-fix.cjs ./node_modules/vitest/vitest.mjs run --configLoader native --pool=threads",
